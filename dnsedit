#!/bin/bash
SERVERIP='127.0.0.1' # Set your server public IP here if desired
BASE='' # Set your (lower case) domain zone name here (e.g. mynetwork.local)
KEYFILE='' # Set the path to your key file for nsupdate here
NAMEDCONF='/etc/bind/named.conf' # Path to named.conf file
ASSUMEBASEZONE='Y' # When zone is unspecified, assume $BASE is the zone. (Any non-blank item is recognized as true)
AUTOPTR='Y' # Auto-create PTR records when adding A records (use noptr to disable)

# The DNSEDITCONF file can be configured with override values for the above options which will supercede 
# the values specified in this script so this file can be used without editing
DNSEDITCONF="$HOME/.dnsedit"
if [[ -f $DNSEDITCONF ]]; then export $(cat $DNSEDITCONF| grep -v '^#'|xargs); fi

ZONE=''
ZONEPTR=''
PTRIP=''
ENTRY=''
ENTRY2=''
IP=''
TYPE='A'
OPERATION='Add'
VERBOSE=''
TTL=''
YES='' # Non-interactive mode (skip confirmation)

# Color codes - only use if output is to a terminal
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  BLUE='\033[0;34m'
  MAGENTA='\033[0;35m'
  CYAN='\033[0;36m'
  WHITE='\033[0;37m'
  BOLD='\033[1m'
  RESET='\033[0m'
  
  function colorize() { echo -e "$1$2$RESET"; }
  function red()    { colorize "$RED" "$1"; }
  function green()  { colorize "$GREEN" "$1"; }
  function yellow(){ colorize "$YELLOW" "$1"; }
  function blue()  { colorize "$BLUE" "$1"; }
  function magenta(){ colorize "$MAGENTA" "$1"; }
  function cyan()  { colorize "$CYAN" "$1"; }
  function bold()  { colorize "$BOLD" "$1"; }
else
  function red()    { echo "$1"; }
  function green()  { echo "$1"; }
  function yellow(){ echo "$1"; }
  function blue()  { echo "$1"; }
  function magenta(){ echo "$1"; }
  function cyan()  { echo "$1"; }
  function bold()  { echo "$1"; }
fi

# Safe population of ALLZONES - check if NAMEDCONF exists first
if [[ -f "$NAMEDCONF" ]]; then
  ALLZONES=($(grep 'zone ' "$NAMEDCONF" | awk '{print $2}' | tr '[:upper:]' '[:lower:]'))
else
  ALLZONES=()
  echo "Warning: $NAMEDCONF not found. Zone auto-detection disabled." >&2
fi

function usage() {
  echo -e "${BOLD}Usage:${RESET} dnsedit [options] [entry] [ip] [zone]"
  echo
  echo -e "${BOLD}Options:${RESET}"
  echo -e "  ${CYAN}-?, -h, --help${RESET} Show this help message"
  echo -e "  ${CYAN}-v${RESET}             Verbose output"
  echo -e "  ${CYAN}-y${RESET}             Yes/Non-interactive mode (skip confirmation)"
  echo -e "  ${CYAN}-ip <addr>${RESET}     Specify IP address"
  echo -e "  ${CYAN}noptr${RESET}          Don't auto-create PTR record when adding A record"
  echo -e "  <number>       Specify TTL"
  echo
  echo -e "${BOLD}Commands:${RESET}"
  echo -e "  ${GREEN}add${RESET}            Add record (default)"
  echo -e "  ${GREEN}del|rm|remove${RESET}  Record to delete"
  echo -e "  ${GREEN}list|ls${RESET}       List records"
  echo
  echo -e "${BOLD}Record Types:${RESET}"
  echo -e "  ${CYAN}a${RESET}              A record (default)"
  echo -e "  ${CYAN}ptr${RESET}            PTR record"
  echo -e "  ${CYAN}ns${RESET}             NS record"
  echo -e "  ${CYAN}cname${RESET}          CNAME record"
  echo -e "  ${CYAN}mx${RESET}             MX record"
  echo -e "  ${CYAN}txt${RESET}            TXT record"
  echo
  echo -e "${BOLD}Examples:${RESET}"
  echo -e "  ${YELLOW}dnsedit ns1 192.168.1.10 foo.bar.local${RESET}"
  echo -e "  ${YELLOW}dnsedit NS ns1 foo.bar.local${RESET}"
  echo -e "  ${YELLOW}dnsedit -y del ns1 foo.bar.local${RESET}"
  echo -e "  ${YELLOW}dnsedit list foo.bar.local${RESET}"
  echo -e "  ${YELLOW}dnsedit -no-ptr ns1 192.168.1.10 foo.bar.local${RESET}"
  echo
  echo "Note: Parameters can be provided in any order unless otherwise specified"
  exit 0
}

function dump() {
  echo "ZONE: $ZONE ; IP: $IP"
  echo "ENTRY: $ENTRY ; ENTRY2: $ENTRY2"
}

# Parse input options and figure out what someone has asked for...
while [[ $# -gt 0 ]]; do
  lc="${1,,}"
  case $lc in
    -\?|-h|--help) usage ;;
    a) TYPE='A' ;;
    ptr) TYPE='PTR' ;;
    ns) TYPE='NS' ;;
    cname) TYPE='CNAME' ;;
    mx) TYPE='MX' ;;
    txt) TYPE='TXT' ;;
    del|rem|remove|rm) OPERATION='Del' ;;
    add) OPERATION='Add' ;;
    list|ls) OPERATION='List' ;;
    -v*) VERBOSE='yes' ;;
    -y) YES='yes' ;;
    noptr) AUTOPTR='' ;;
    -ip) if [[ $2 =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then IP=$2; else echo "Invalid IP specified"; exit 1; fi; shift ;;
    *)
      if [[ ${ALLZONES[@]} =~ \"$lc\" ]]; then ZONE=$lc
      elif [[ $lc =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then IP=$lc
      elif [[ ${ALLZONES[@]} =~ \"$lc.$BASE\" ]]; then ZONE=$lc.$BASE
      elif [[ $lc != ${lc/\./} ]]; then echo "$lc not valid zone or IP"
      elif [[ $lc =~ ^[0-9]+$ ]]; then TTL=$lc
      elif [[ -z $ENTRY ]]; then ENTRY=$lc
      elif [[ -z $ENTRY2 ]]; then ENTRY2=$lc
      else
        echo "Unknown $lc"
      fi
      ;;
  esac
  shift
done
if [[ -z $ZONE && -n $ASSUMEBASEZONE ]]; then ZONE=$BASE; fi
EXISTING_RECORDS=$(dig +noquestion +nocmd +nocomments +nostat @$SERVERIP AXFR $ZONE)
[[ -z $VERBOSE ]] || dump

TOPS="server $SERVERIP\n"
TOP="${TOPS}zone $ZONE\n"
BOT="show\nsend"
# Note: A blank line is processed as a send

function doAddA() {
  [[ -n $TTL ]] || TTL=86400
  echo -e "${TOP}update add $ENTRY.$ZONE $TTL $TYPE $IP\n${BOT}" | nsupdate -k "$KEYFILE"
  # Auto-create PTR if enabled (PTRIP and ZONEPTR already computed in check())
  if [[ -n $AUTOPTR && -n $ZONEPTR ]]; then
    echo "Auto-creating PTR record: $PTRIP.in-addr.arpa -> $ENTRY.$ZONE"
    echo -e "${TOPS}zone $ZONEPTR\nupdate add $PTRIP.in-addr.arpa. 4800 PTR $ENTRY.$ZONE.\n${BOT}" | nsupdate -k "$KEYFILE"
  fi
}

function doDelA() {
  echo -e "${TOP}update del $ENTRY.$ZONE $TYPE $IP\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doAddCNAME() {
  [[ -n $TTL ]] || TTL=4800
  echo -e "${TOP}update add $ENTRY.$ZONE $TTL CNAME $ENTRY2.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doDelCNAME() {
  echo -e "${TOP}update del $ENTRY.$ZONE CNAME $ENTRY2.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doAddPTR() {
  [[ -n $TTL ]] || TTL=4800
  echo -e "${TOPS}update add $PTRIP.in-addr.arpa. $TTL PTR $ENTRY.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doDelPTR() {
  echo -e "${TOPS}update del $PTRIP.in-addr.arpa. PTR $ENTRY.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doAddNS() {
  [[ -n $TTL ]] || TTL=21600
  echo -e "${TOP}update add $ENTRY.$ZONE. $TTL $TYPE $ENTRY2.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doDelNS() {
  echo -e "${TOP}update del $ENTRY.$ZONE. $TYPE $ENTRY2.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doAddMX() {
  [[ -n $TTL ]] || TTL=3600
  # MX records require priority (first number) - use 10 as default
  local PRIORITY=10
  echo -e "${TOP}update add $ZONE $TTL MX $PRIORITY $ENTRY.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doDelMX() {
  echo -e "${TOP}update del $ZONE MX $ENTRY.$ZONE\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doAddTXT() {
  [[ -n $TTL ]] || TTL=3600
  # ENTRY2 contains the TXT value
  echo -e "${TOP}update add $ENTRY.$ZONE $TTL TXT \"$ENTRY2\"\n${BOT}" | nsupdate -k "$KEYFILE"
}

function doDelTXT() {
  echo -e "${TOP}update del $ENTRY.$ZONE TXT\n${BOT}" | nsupdate -k "$KEYFILE"
}

function isPTR() { [[ $TYPE == PTR ]]; }
function isNS() { [[ $TYPE == NS ]]; }
function isA() { [[ $TYPE == A ]]; }
function isCNAME() { [[ $TYPE == CNAME ]]; }
function isMX() { [[ $TYPE == MX ]]; }
function isTXT() { [[ $TYPE == TXT ]]; }
function isAdd() { [[ $OPERATION == 'Add' ]]; }
function isDel() { [[ $OPERATION == 'Del' ]]; }

function lookupZone() {
  grep "^$1.$ZONE" <<<$EXISTING_RECORDS 2>/dev/null || true
}
function lookupIP() {
  grep "$1$" <<<$EXISTING_RECORDS 2>/dev/null || true
}

function check() {
  has_ip=''
  has_name2=''
  has_ptr=''
  if [[ -n $IP ]]; then has_ip=$(lookupIP $IP); fi
  has_name=$(lookupZone $ENTRY)
  if [[ -n $ENTRY2 ]]; then has_name2=$(lookupZone $ENTRY2); fi
  if [[ -n $has_name && -z $has_name2 ]] && (isNS || isCNAME); then z=$ENTRY2; ENTRY2=$ENTRY; ENTRY=$z; has_name=$(lookupZone $ENTRY); has_name2=$(lookupZone $ENTRY2);fi
  if [[ $TYPE == A ]] || isPTR; then
    PTRIP=$(awk -F. '{print $4"."$3"."$2"."$1}' <<<$IP)
  fi
  if isA || isPTR; then
    zonetmp="${PTRIP#*.*}.in-addr.arpa"
    for n in $(seq 1 3); do
      if [[ ${ALLZONES[@]} =~ \"$zonetmp\" ]]; then ZONEPTR=$zonetmp; fi
      zonetmp="${zonetmp#*.*}"
    done
    has_ptr=$(dig +noquestion +nocmd +nocomments +nostat @$SERVERIP AXFR $ZONEPTR | grep "^$PTRIP.in-addr.arpa")
  fi
  # Perform checks
  if [[ -z $ZONE ]]; then echo "$(red 'Error:') You did not specify a zone"; return 1
  elif [[ -z $ENTRY ]]; then echo "$(red 'Error:') You did not specify a name to edit"; return 1
  elif isNS && [[ -z $ENTRY2 ]]; then echo "$(red 'Error:') You did not specify a glue record to add"; return 1
  elif isCNAME && [[ -z $has_name2 ]]; then echo "$(red 'Error:') Specified A record does not exist - create the A record first"; return 1
  elif isMX && [[ -z $ENTRY ]]; then echo "$(red 'Error:') You did not specify a mailserver name for MX record"; return 1
  elif isTXT && [[ -z $ENTRY2 ]]; then echo "$(red 'Error:') You did not specify TXT record value"; return 1
  elif isNS && [[ -z $has_name2 ]]; then echo "$(red 'Error:') Specified glue record '$ENTRY2' does not exist"; return 1
  elif [[ -z $IP ]] && ! isNS && ! isCNAME && ! isMX && ! isTXT; then echo "$(red 'Error:') You did not specify an IP to add"; return 1
  elif (isAdd && [[ -n $has_ip ]] && ! isPTR); then echo "$(red 'Error:') IP exists already $has_ip"; return 1
  #elif (isDel && [[ -z $has_ip ]]); then echo "$(red 'Error:') Cannot find IP $IP to delete!"; return 1
  elif (isDel && [[ -z $has_name ]]); then echo "$(red 'Error:') Cannot find $ENTRY to delete it!"; return 1
  elif [[ -z $has_name ]] && isPTR; then echo "$(red 'Error:') Name $ENTRY does not exist yet!"; return 1
  elif isPTR && [[ -z $ZONEPTR ]]; then echo "$(red 'Error:') Could not identify PTR zone for $IP"; return 1
  elif isPTR && [[ -n $has_ptr ]]; then echo "$(red 'Error:') PTR record already exists!"; return 1
  fi
  # Warnings only
  if (isA || isPTR) && [[ -z $ZONEPTR ]]; then echo "$(yellow 'Warning:') PTR Zone not found for $IP"
  elif (isAdd && [[ -n $has_name ]] && ! isPTR); then echo "$(yellow 'Warning:') Name exists already $has_name"
  fi
  if isAdd; then echo -n "$(green 'Adding')"; elif isDel; then echo -n "$(red 'Deleting')"; fi
  echo -n " $TYPE $ENTRY "
  if isNS; then echo "to zone $ZONE stub $ENTRY2"
  elif isCNAME; then echo "$(yellow '->') $ENTRY2 to zone $ZONE"
  elif isMX; then echo "to zone $ZONE"
  elif isTXT; then echo "to zone $ZONE"
  else echo "with IP $IP to zone $ZONE"; fi
  if [[ -n $YES ]]; then
    echo "$(green '(non-interactive mode)')"
  else
    read -p "$(bold 'Press <enter> to continue')"
  fi
  # Return 0 to continue
  return 0
}

if [[ $OPERATION == List ]]; then
  dig +noquestion +nocmd +nocomments +nostat @$SERVERIP AXFR $ZONE | grep -w $TYPE
elif check; then
  case "${OPERATION}${TYPE}" in
    AddA) doAddA ;;
    DelA) doDelA ;;
    AddPTR) doAddPTR ;;
    DelPTR) doDelPTR ;;
    AddNS) doAddNS ;;
    DelNS) doDelNS ;;
    AddCNAME) doAddCNAME ;;
    DelCNAME) doDelCNAME ;;
    AddMX) doAddMX ;;
    DelMX) doDelMX ;;
    AddTXT) doAddTXT ;;
    DelTXT) doDelTXT ;;
    *) echo "Unknown operation: $OPERATION $TYPE"; exit 1 ;;
  esac
fi
